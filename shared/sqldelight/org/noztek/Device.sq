CREATE TABLE Device (
    device_id TEXT NOT NULL PRIMARY KEY,
    user_id TEXT NOT NULL,
    device_name TEXT NOT NULL,
    platform TEXT NOT NULL,
    registration_id INTEGER NOT NULL,
    identity_key_public TEXT NOT NULL,
    identity_key_private TEXT NOT NULL,
    is_current INTEGER NOT NULL DEFAULT 1,
    updated_at INTEGER NOT NULL
);

upsertDevice:
INSERT OR REPLACE INTO Device(
    device_id,
    user_id,
    device_name,
    platform,
    registration_id,
    identity_key_public,
    identity_key_private,
    is_current,
    updated_at
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

selectCurrentDevice:
SELECT * FROM Device WHERE is_current = 1 ORDER BY updated_at DESC LIMIT 1;

clearCurrentFlag:
UPDATE Device SET is_current = 0;

deleteDeviceById:
DELETE FROM Device WHERE device_id = ?;

selectDeviceById:
SELECT * FROM Device WHERE device_id = ? LIMIT 1;
