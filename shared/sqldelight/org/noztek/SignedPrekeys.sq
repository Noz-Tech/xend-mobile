CREATE TABLE SignedPrekeys (
    device_id TEXT NOT NULL,
    key_id INTEGER NOT NULL,
    public_key TEXT NOT NULL,
    private_key TEXT NOT NULL,
    signature TEXT NOT NULL,
    uploaded_at INTEGER,
    PRIMARY KEY(device_id, key_id),
    FOREIGN KEY(device_id) REFERENCES Device(device_id) ON DELETE CASCADE
);

upsertSignedPrekey:
INSERT OR REPLACE INTO SignedPrekeys(
    device_id,
    key_id,
    public_key,
    private_key,
    signature,
    uploaded_at
)
VALUES (?, ?, ?, ?, ?, ?);

selectLatestSignedPrekeyForDevice:
SELECT *
FROM SignedPrekeys
WHERE device_id = ?
ORDER BY key_id DESC
LIMIT 1;

selectAllSignedPrekeysForDevice:
SELECT *
FROM SignedPrekeys
WHERE device_id = ?
ORDER BY key_id DESC;

deleteSignedPrekeysForDevice:
DELETE FROM SignedPrekeys WHERE device_id = ?;
